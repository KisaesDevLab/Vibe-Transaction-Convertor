# Phase 28 #5: Caddy reverse proxy. {$VIBETC_DOMAIN} substitutes the
# operator-set hostname (e.g. tx.example.com). Caddy auto-provisions
# Let's Encrypt certs when the domain is publicly reachable; for LAN
# deployments set VIBETC_DOMAIN to ":80" and uncomment the
# tls internal block to issue self-signed certs.

{$VIBETC_DOMAIN} {
	encode gzip

	# Strict transport, sane content-type sniffing, and a CSP that
	# matches what helmet sets at the API layer.
	header {
		Strict-Transport-Security "max-age=15552000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "no-referrer"
		# Helmet already sets these on /api/* responses; keep them at
		# the proxy layer too so static assets get them.
		-Server
	}

	# Uncomment for LAN-only deployments without a public DNS record:
	# tls internal

	reverse_proxy api:4000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# Cap request bodies at the proxy. The two upload endpoints get their
	# own, larger caps; every other request stays at 32MB. The matchers
	# are mutually exclusive on purpose: stacking an unscoped 32MB limit
	# with a scoped larger one would apply the smaller of the two.
	#  - PDF batch upload (multer enforces MAX_UPLOAD_MB per file and
	#    MAX_BATCH_SIZE files; the batch is buffered in API memory, so
	#    keep this within the API's RAM budget — raise it if you raise
	#    those limits).
	#  - Backup dump upload (streamed to disk; the API enforces
	#    BACKUP_UPLOAD_MAX_MB, default 2048 — keep this above it).
	@pdfUpload path /api/accounts/*/uploads
	@backupUpload path /api/admin/backups/upload
	@otherBody not path /api/accounts/*/uploads /api/admin/backups/upload
	request_body @pdfUpload {
		max_size 1GB
	}
	request_body @backupUpload {
		max_size 8GB
	}
	request_body @otherBody {
		max_size 32MB
	}
}
